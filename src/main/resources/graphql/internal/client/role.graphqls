extend type Query {
    clientPaginateRole(paginateRequest: PaginateRequest): RolePaginate!
    clientPaginateRoleFilter(filter: RoleFilterQueryParamInput): RolePaginate!
    clientFindByUuidRole(uuid: ID!): RoleResponse
    clientFindByNameRole(name: String!): RoleResponse
}

extend type Mutation {
    clientSaveRole(roleRequest: RoleRequest!): RoleResponse
    clientUpdateRole(uuid: ID!, roleRequest: RoleRequest!): RoleResponse
    clientDeleteByUuidRole(uuid: ID!): Boolean
}
