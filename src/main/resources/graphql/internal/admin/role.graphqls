extend type Query {
    adminPaginateRole(paginateRequest: PaginateRequest): RolePaginate!
    adminPaginateRoleFilter(filter: RoleFilterQueryParamInput): RolePaginate!
    adminFindByUuidRole(uuid: ID!): RoleResponse
    adminFindByNameRole(name: String!): RoleResponse
}

extend type Mutation {
    adminSaveRole(roleRequest: RoleRequest!): RoleResponse
    adminUpdateRole(uuid: ID!, roleRequest: RoleRequest!): RoleResponse
    adminDeleteByUuidRole(uuid: ID!): Boolean
}
